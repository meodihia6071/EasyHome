# Development only; change ALL values before deployment.
JWT_SECRET=replace-with-random-long-secret-at-least-32-characters
MYSQL_PASSWORD=easyhome_dev_change_me
MYSQL_ROOT_PASSWORD=easyhome_root_change_me
APP_SEED_DEMO=true
APP_MOCK_PAYMENTS=true

# Gmail SMTP OTP (set in terminal/process environment; .env.example is documentation only)
APP_EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourgmail@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
APP_EMAIL_FROM=yourgmail@gmail.com
